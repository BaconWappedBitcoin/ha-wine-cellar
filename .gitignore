frontend-src/node_modules/

# Personal/local Claude Code instructions — read automatically alongside
# CLAUDE.md, but never committed (may reference machine-specific tooling).
CLAUDE.local.md

# graphify's generated knowledge graph — 4 MB, rebuilt from source in ~6s by
# `graphify update .`, so it is derived data rather than something to carry in
# the repo. The rules for using it live in CLAUDE.md.
graphify-out/

# Machine-specific Claude Code config. Hooks here carry absolute paths to
# tooling that only exists on one machine, so committing them hands every
# other clone a hook pointing at a binary they do not have.
.claude/settings.json
.claude/settings.local.json
.claude/settings.json.graphify-bak
